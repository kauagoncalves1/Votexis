# === Votexis Backend — Variáveis de Ambiente ===
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env real.

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/votexis

# JWT (preencher nas partes futuras)
SECRET_KEY=troque-por-uma-chave-secreta-forte
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
